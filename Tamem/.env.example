# TAMEM — the Markov chat bot.
#
# Its own Discord application, but it runs inside the main process (index.js)
# because it pays coins out of the shared wallet. Do not start it separately.
#
# This is the EXAMPLE file and it IS committed. Never put a real token in here —
# copy it to "Tamem/.env", which is gitignored, and fill that in instead.
#
# Tamem needs the MESSAGE CONTENT INTENT switched on for its application under
# Bot -> Privileged Gateway Intents. Without it every message arrives empty and
# Tamem never learns a word.

# Bot token: developer portal -> your Tamem app -> Bot
TAMEM_TOKEN=

# Application ID from the same app's "General Information" page
TAMEM_CLIENT_ID=
