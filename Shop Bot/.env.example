# KALLEN — the shop bot.
#
# Its own Discord application, but it runs inside the main process (index.js)
# because it spends out of the shared coin wallet. Do not start it separately.
#
# This is the EXAMPLE file and it IS committed — .gitignore line 7 un-ignores
# it on purpose. Never put a real token in here. Copy it to "Shop Bot/.env",
# which is ignored, and fill that in instead.

# Bot token: developer portal -> your KALLEN app -> Bot
SHOP_TOKEN=

# Application ID from the same app's "General Information" page
SHOP_CLIENT_ID=

# Who can run /kallen. Comma separated Discord user ids, no spaces. The server
# owner can always run it, so this is for anyone else you want in the queue.
SHOP_OWNER_IDS=
