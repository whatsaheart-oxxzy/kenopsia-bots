# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application ID from the same app's "General Information" page
CLIENT_ID=

# Server ID to register commands into (right-click the server -> Copy Server ID,
# needs Developer Mode on). Leave empty to register globally instead.
GUILD_ID=

# Anthropic API key for the ECHO Oracle NPC (https://console.anthropic.com).
# Optional — without it everything else still works, the Oracle just stays quiet.
ANTHROPIC_API_KEY=

# Local hour (0-23) for the Morning Echo and Daily Quest post. Optional, default 9.
ECHO_QUEST_HOUR=9
