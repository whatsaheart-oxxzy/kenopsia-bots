# The server's .env — one file for all four bots.
#
# On your PC each bot reads its own .env (.env, Virtual Pet/.env,
# Voice Bot/.env, roblox-verify/.env). In the container none of those files
# exist: .dockerignore keeps them out, so the `if (fs.existsSync(envFile))`
# guards in index.js simply skip them and every bot reads the real environment
# variables that docker-compose injects from this file instead.
#
# On the server:  cp .env.deploy.example .env  and fill it in.
# Never commit it. .gitignore already covers it.

# --- shared ---------------------------------------------------------------

# Your Discord server ID. All four bots refuse to act in any other server
# (lib/guild-lock.js), so this must be right.
GUILD_ID=

# --- C.C (main bot: levels, coins, quests, moderation) --------------------

DISCORD_TOKEN=
CLIENT_ID=

# --- SUZAKU (Virtual Pet) -------------------------------------------------
# Runs inside the C.C container. Leave PET_TOKEN empty to disable the pet bot;
# index.js:60 logs that it was skipped and everything else still starts.

PET_TOKEN=
PET_CLIENT_ID=

# --- SHIRLEY (Voice Bot) --------------------------------------------------
# Also inside the C.C container. Same deal: empty VOICE_TOKEN disables it.

VOICE_TOKEN=
VOICE_CLIENT_ID=

# --- LELOUCH (Roblox verify) ----------------------------------------------
# Its own container. Uses only the public Roblox API, no Roblox credentials.

VERIFY_TOKEN=
VERIFY_CLIENT_ID=

# --- deliberately not set -------------------------------------------------
#
# ANTHROPIC_API_KEY is left out on purpose. The ECHO Oracle is the only thing
# that would spend it, and lib/echo/oracle.js:31 gates the whole feature on
# this variable being present — no key, no API calls, no bill. (As of now
# registerEcho in lib/echo/runtime.js:37 is never called from index.js, so it
# is switched off twice over.) Only add it here if you deliberately wire ECHO
# back up and accept the cost of a bot that answers unattended, 24 hours a day.
